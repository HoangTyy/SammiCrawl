# Optional keys for worker and remote LLM bridge. Website login and PostgreSQL use backend/appsettings.json.
WORKER_API_KEY=REPLACE_WITH_RANDOM_WORKER_KEY
REMOTE_AI_KEY=REPLACE_WITH_RANDOM_BRIDGE_KEY
# Only required when explicitly starting the legacy-sql profile.
SQL_PASSWORD=REPLACE_WITH_STRONG_SQL_SERVER_PASSWORD
