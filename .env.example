# Copy to .env and replace every placeholder locally. Never commit .env.
POSTGRES_CONNECTION=Host=YOUR_POSTGRES_HOST;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USER;Password=REPLACE_ME;SSL Mode=VerifyCA;Root Certificate=/app/config/postgres/server.crt
WORKER_API_KEY=REPLACE_WITH_RANDOM_WORKER_KEY
REMOTE_AI_KEY=REPLACE_WITH_RANDOM_BRIDGE_KEY
# Only used with the legacy-sql profile:
SQL_PASSWORD=REPLACE_WITH_STRONG_SQL_SERVER_PASSWORD
